# Optional. The app defaults to the origin that served the page, which is what
# LAN phones need (http://<lan-ip>:4000). Set this only to point at a different
# server. In dev, Vite proxies /api and /socket.io to the mock on port 4000.
# VITE_SERVER_URL=http://localhost:4000

# Port for the mock server (mock/server.mjs). Not read by the app.
MOCK_PORT=4000
