# Point this at the real game server when it is ready. The default is the local mock.
VITE_SERVER_URL=http://localhost:4000

# Host JWT from POST /api/auth/signup or /api/auth/login. The mock accepts any
# non-empty token, and the host screen falls back to "mock-host-token" locally.
VITE_HOST_TOKEN=

# Port for the mock server (mock/server.mjs). Not read by the app.
MOCK_PORT=4000
