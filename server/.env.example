# Server
PORT=4000
HOST=0.0.0.0

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/quiz_platform

# Auth. Use a long random value in production.
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated allowed origins, or * for development.
CORS_ORIGIN=*

# Game timing
REVEAL_MS=5000
MAX_PLAYERS_PER_ROOM=1000
ROOM_TTL_MS=3600000
LOBBY_TTL_MS=43200000
