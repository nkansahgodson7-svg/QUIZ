# Server
PORT=4000
HOST=0.0.0.0

# SQLite database file. The parent directory is created automatically.
QUIZ_DB_PATH=./data/quiz.db

# Built client directory (SPA static files).
CLIENT_DIR=../client/dist

# Comma-separated allowed origins, or * for development.
CORS_ORIGIN=*

# Game timing
REVEAL_MS=5000
MAX_PLAYERS_PER_ROOM=1000
ROOM_TTL_MS=3600000
LOBBY_TTL_MS=43200000
